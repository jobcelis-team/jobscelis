{
  "_comment": "Single source of truth for every SDK and tool shown in /docs and the README. The CI job `mix sdk_catalog.check` fails when a jobcelis-team repository or an sdks/ directory is missing here, a link is broken, or a package is not published. `version` is only the fallback: the app reads the latest version from each registry at runtime. `{version}` and `{minor}` in `install` are filled in with it.",
  "sdks": [
    {"id": "nodejs", "label": "Node.js", "registry": "npm", "url": "https://www.npmjs.com/package/@jobcelis/sdk", "repo": "jobcelis-team/jobscelis", "path": "sdks/node", "latest": {"source": "npm", "package": "@jobcelis/sdk"}, "version": "1.9.1", "install": "npm install @jobcelis/sdk"},
    {"id": "python", "label": "Python", "registry": "PyPI", "url": "https://pypi.org/project/jobcelis/", "repo": "jobcelis-team/jobscelis", "path": "sdks/python", "latest": {"source": "pypi", "package": "jobcelis"}, "version": "1.6.0", "install": "pip install jobcelis"},
    {"id": "go", "label": "Go", "registry": "pkg.go.dev", "url": "https://pkg.go.dev/github.com/jobcelis-team/go-jobcelis", "repo": "jobcelis-team/go-jobcelis", "latest": {"source": "go", "package": "github.com/jobcelis-team/go-jobcelis"}, "version": "1.5.0", "install": "go get github.com/jobcelis-team/go-jobcelis"},
    {"id": "php", "label": "PHP", "registry": "Packagist", "url": "https://packagist.org/packages/jobcelis/sdk", "repo": "jobcelis-team/jobcelis-php", "latest": {"source": "packagist", "package": "jobcelis/sdk"}, "version": "1.3.0", "install": "composer require jobcelis/sdk"},
    {"id": "ruby", "label": "Ruby", "registry": "RubyGems", "url": "https://rubygems.org/gems/jobcelis", "repo": "jobcelis-team/jobcelis-ruby", "latest": {"source": "rubygems", "package": "jobcelis"}, "version": "1.3.0", "install": "gem install jobcelis"},
    {"id": "elixir", "label": "Elixir", "registry": "Hex.pm", "url": "https://hex.pm/packages/jobcelis", "repo": "jobcelis-team/jobcelis-elixir", "latest": {"source": "hex", "package": "jobcelis"}, "version": "1.3.0", "install": "{:jobcelis, \"~> {minor}\"}  # add to mix.exs deps"},
    {"id": "dotnet", "label": ".NET", "registry": "NuGet", "url": "https://www.nuget.org/packages/Jobcelis", "repo": "jobcelis-team/jobcelis-dotnet", "latest": {"source": "nuget", "package": "Jobcelis"}, "version": "1.3.0", "install": "dotnet add package Jobcelis"},
    {"id": "rust", "label": "Rust", "registry": "crates.io", "url": "https://crates.io/crates/jobcelis", "repo": "jobcelis-team/jobcelis-rust", "latest": {"source": "crates", "package": "jobcelis"}, "version": "1.3.1", "install": "cargo add jobcelis"},
    {"id": "swift", "label": "Swift", "registry": "SPM", "url": "https://github.com/jobcelis-team/jobcelis-swift", "repo": "jobcelis-team/jobcelis-swift", "latest": {"source": "github_tags", "package": "jobcelis-team/jobcelis-swift"}, "version": "1.3.1", "install": "// Swift Package Manager\n.package(url: \"https://github.com/jobcelis-team/jobcelis-swift\", from: \"{version}\")"},
    {"id": "java", "label": "Java", "registry": "Maven Central", "url": "https://central.sonatype.com/artifact/com.jobcelis/jobcelis", "repo": "jobcelis-team/jobcelis-java", "latest": {"source": "maven", "package": "com.jobcelis:jobcelis"}, "version": "1.3.1", "install": "<!-- Maven -->\n<dependency>\n  <groupId>com.jobcelis</groupId>\n  <artifactId>jobcelis</artifactId>\n  <version>{version}</version>\n</dependency>"},
    {"id": "dart", "label": "Dart", "registry": "pub.dev", "url": "https://pub.dev/packages/jobcelis", "repo": "jobcelis-team/jobcelis-dart", "latest": {"source": "pub", "package": "jobcelis"}, "version": "1.3.0", "install": "dart pub add jobcelis"},
    {"id": "kotlin", "label": "Kotlin", "registry": "Maven Central", "url": "https://central.sonatype.com/artifact/com.jobcelis/jobcelis-kotlin", "repo": "jobcelis-team/jobcelis-kotlin", "latest": {"source": "maven", "package": "com.jobcelis:jobcelis-kotlin"}, "version": "1.3.1", "install": "implementation(\"com.jobcelis:jobcelis-kotlin:{version}\")"}
  ],
  "tools": [
    {"id": "cli", "label": "CLI", "registry": "npm", "url": "https://www.npmjs.com/package/@jobcelis/cli", "repo": "jobcelis-team/jobscelis", "path": "sdks/cli", "latest": {"source": "npm", "package": "@jobcelis/cli"}, "version": "2.2.1", "install": "npm install -g @jobcelis/cli"},
    {"id": "terraform", "label": "Terraform", "registry": "Terraform Registry", "url": "https://registry.terraform.io/providers/jobcelis-team/jobcelis/latest", "repo": "jobcelis-team/terraform-provider-jobcelis", "latest": {"source": "terraform", "package": "jobcelis-team/jobcelis"}, "version": "1.3.2", "install": "terraform {\n  required_providers {\n    jobcelis = {\n      source  = \"jobcelis-team/jobcelis\"\n      version = \"~> {minor}\"\n    }\n  }\n}"},
    {"id": "github-action", "label": "GitHub Action", "registry": "GitHub", "url": "https://github.com/jobcelis-team/jobscelis/tree/main/sdks/github-action", "repo": "jobcelis-team/jobscelis", "path": "sdks/github-action", "latest": null, "version": null, "install": "- uses: jobcelis-team/jobscelis/sdks/github-action@main"}
  ],
  "ignored_repos": ["jobcelis-team/jobscelis", "jobcelis-team/.github"]
}
